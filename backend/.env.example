# Server
PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgresqlpassword@localhost:5432/databasename
DEMO_MODE=false
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=15
FRONTEND_URL=http://localhost:5174

# SMTP password-reset delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
MAIL_FROM=Stock Management System <no-reply@example.com>
PG_POOL_MAX=2
PG_IDLE_TIMEOUT_MS=10000
PG_CONNECTION_TIMEOUT_MS=5000
PG_MAX_USES=500

# Auth
JWT_SECRET=jwt-secret-token
JWT_EXPIRES_IN=8h

# CORS - the frontend's dev server origin
CORS_ORIGIN=http://localhost:5174
